APP_NAME="PNK Global Campus"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database (Database Design document — MySQL 8.x)
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pn_knowledge_campus
DB_USERNAME=root
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Session / Cache / Queue
# ---------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

# ---------------------------------------------------------------------------
# Sanctum / CORS — SPA (React) domains allowed to authenticate
# ---------------------------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=localhost:5173
SESSION_DOMAIN=localhost
FRONTEND_URL=http://localhost:5173
# Audit fix (Medium remediation) — bearer tokens expire after this many
# minutes (43200 = 30 days); see config/sanctum.php.
SANCTUM_TOKEN_EXPIRATION_MINUTES=43200

# ---------------------------------------------------------------------------
# Backups (audit fix, Critical remediation — spatie/laravel-backup).
# Where the daily database + file backup's success/failure notification
# is sent; defaults to MAIL_FROM_ADDRESS if unset (see config/backup.php).
# ---------------------------------------------------------------------------
# BACKUP_NOTIFICATION_EMAIL=admin@pnknowledgecampus.edu

# Encrypts the backup zip archive (AES-256) so a leaked/stolen backup file
# — which contains the full database, including applicant PII — isn't
# readable on its own. Leaving this unset ships backups UNENCRYPTED; set
# a strong, random password here and store it somewhere other than this
# file (e.g. your secrets manager) before going to production.
# BACKUP_ARCHIVE_PASSWORD=

# ---------------------------------------------------------------------------
# Reverse proxy (Milestone 25, Production Readiness). Leave unset for
# local development (no proxy in front of PHP) and for a deploy that
# terminates TLS in the same process/container as PHP. If a load
# balancer, Nginx, or CDN sits in front of this app and forwards
# X-Forwarded-For/Proto, set this or every request's ->ip() and
# ->isSecure() will report the proxy's own address/scheme instead of
# the real client's — set to "*" if the proxy's own IP isn't fixed
# (common on managed platforms), otherwise a comma-separated IP/CIDR
# list of the proxies you actually trust. See bootstrap/app.php.
# TRUSTED_PROXIES=*

# ---------------------------------------------------------------------------
# Mail (used by password reset — SMTP is also editable later via the
# Settings module once it ships in Milestone 1; this is the bootstrap value)
# ---------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@pnknowledgecampus.edu"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Filesystem / Media
# ---------------------------------------------------------------------------
FILESYSTEM_DISK=public
MEDIA_DISK=public
MEDIA_MAX_UPLOAD_SIZE=10485760

# To switch the Media Library to S3-compatible storage later: set
# FILESYSTEM_DISK=s3 and MEDIA_DISK=s3, fill in the values below, and run
# `composer require league/flysystem-aws-s3-v3` (not installed by
# default — no code change needed either way, per config/filesystems.php).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=
# AWS_BUCKET=
# AWS_URL=
# AWS_ENDPOINT=
# AWS_USE_PATH_STYLE_ENDPOINT=false
