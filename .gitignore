# Audit fix (Critical remediation) — this project had no version control
# and no .gitignore at all; this file exists specifically so the first
# commit never includes secrets (.env) or build output (dist/, vendor/,
# node_modules/).

# ---------------------------------------------------------------------------
# Backend (Laravel)
# ---------------------------------------------------------------------------
backend/vendor/
backend/node_modules/
backend/.env
backend/.env.backup
backend/.env.production
backend/.phpunit.result.cache
backend/.phpunit.cache
backend/Homestead.json
backend/Homestead.yaml
backend/auth.json
backend/npm-debug.log
backend/yarn-error.log

backend/bootstrap/cache/*.php
!backend/bootstrap/cache/.gitignore

backend/storage/*.key
backend/storage/app/*
!backend/storage/app/public
!backend/storage/app/.gitignore
backend/storage/app/public/*
!backend/storage/app/public/.gitignore
backend/storage/app/private/*
!backend/storage/app/private/.gitignore
backend/storage/framework/cache/*
!backend/storage/framework/cache/.gitignore
backend/storage/framework/sessions/*
!backend/storage/framework/sessions/.gitignore
backend/storage/framework/testing/*
!backend/storage/framework/testing/.gitignore
backend/storage/framework/views/*
!backend/storage/framework/views/.gitignore
backend/storage/logs/*.log
!backend/storage/logs/.gitignore
backend/storage/media-library/

# The storage:link symlink is environment-specific and regenerated by
# `php artisan storage:link` on every deploy — not something to commit.
backend/public/storage

# ---------------------------------------------------------------------------
# Frontend (React / Vite)
# ---------------------------------------------------------------------------
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.env.local
frontend/.env.*.local
frontend/*.local
frontend/*.tsbuildinfo

# ---------------------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
